# Car Sense AI — environment variables
#
# Backend (database, auth, storage) is provisioned automatically by Lovable Cloud.
# These VITE_* values are injected into the local .env for you and are safe to
# expose in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional: base URL of your own damage-detection API (for example a YOLOv8
# FastAPI service). When empty, the app runs in demo inference mode and clearly
# labels every result as simulated.
#
# Contract expected by src/services/ai/damageDetectionService.ts:
#   POST {VITE_AI_API_URL}/api/detect-damage
#   multipart/form-data, field name: image
#   200 -> { "success": true, "detections": [
#             { "class": "scratch" | "dent" | "crack" | "broken_part",
#               "confidence": 0.0-1.0,
#               "severity": "minor" | "moderate" | "severe",
#               "part": "front_bumper",
#               "bbox": [x, y, width, height] } ] }
VITE_AI_API_URL=

# Optional: Google Maps API key. Only used to render static map previews.
# Directions and navigation links work without it.
VITE_GOOGLE_MAPS_API_KEY=
